# OpenAI API Key for natural language to SQL conversion
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# Query and cache settings that the server actually applies
QUERY_DEFAULT_LIMIT=1000
QUERY_HISTORY_RETENTION=50
METADATA_CACHE_HOURS=24
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_COMMAND_TIMEOUT=60

# Access control. EXPLAIN stays off until a database policy or this flag enables it.
SECURITY_BLOCKED_TABLES=
SECURITY_BLOCKED_COLUMNS=
SECURITY_ALLOW_EXPLAIN=false
SECURITY_BLOCKED_FUNCTIONS=pg_sleep,pg_terminate_backend,pg_cancel_backend,pg_read_file,pg_read_binary_file,pg_ls_dir,pg_stat_file,lo_import,lo_export,dblink,dblink_exec,pg_write_file,sleep

# Resilience and observability, enforced on the query and SQL-generation path
RATE_LIMIT_QUERY_CONCURRENCY=10
RATE_LIMIT_LLM_CONCURRENCY=5
RATE_LIMIT_ACQUIRE_TIMEOUT=2
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.05
RETRY_MAX_DELAY_SECONDS=1
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
METRICS_ENABLED=true
